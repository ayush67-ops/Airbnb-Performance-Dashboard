table Listings
	lineageTag: 48d7cb0b-399d-4d7b-9eb4-a009d2b1c2ec

	measure 'Private room' =
			
			CALCULATE (
			    COUNT (Listings[listing_id] ),
			    Listings[room_type] = "Private room"
			)
		formatString: 0
		lineageTag: 2d72b0cf-b5a4-4b39-891a-594914ac1b36

	measure 'Hotel room' =
			
			CALCULATE (
			    COUNT (Listings[listing_id] ),
			    Listings[room_type] = "Hotel room"
			)
		formatString: 0
		lineageTag: 7823d903-9a79-4dae-8874-6575322c533d

	measure 'Entire place' =
			
			CALCULATE (
			    COUNT (Listings[listing_id] ),
			    Listings[room_type] = "Entire place"
			)
		formatString: 0
		lineageTag: 312a8b57-5ac9-469b-a657-9f3c539ad21e

	measure 'Shared room' =
			
			CALCULATE (
			    COUNT (Listings[listing_id] ),
			    Listings[room_type] = "Shared room"
			)
		formatString: 0
		lineageTag: c493f2bc-6475-47cf-85d3-134019e04a63

	measure 'Total Listing' = COUNT(Listings[listing_id])
		formatString: 0
		lineageTag: b27da1b6-86a2-4a8d-9ebc-43c75499c946

	measure 'superhost Listings' =
			
			CALCULATE (
			    count ( Listings[listing_id]) ,
			    Listings[host_is_superhost] = "t")
		formatString: 0
		lineageTag: 8c5c2696-4ccb-48e4-bd2c-8bd1d4371351

	measure 'No Superhost Listings' =
			
			CALCULATE (
			    count ( Listings[listing_id]) ,
			    Listings[host_is_superhost] = "f"
			)
		formatString: 0
		lineageTag: 9ab3e1fa-312d-4745-b654-9287d48330ce

	measure 'City Rank' =
			
			RANKX (
			    ALL(Listings[city]),
			    [Total Listing],
			    ,DESC
			)
		formatString: 0
		lineageTag: 8967055a-077e-4f56-aed1-2ea8a65be20f

	measure 'Cumulative Listings' =
			
			VAR CurrentRank =
			    MAXX(
			        VALUES(Listings[city]),
			        [City Rank]
			    )
			RETURN
			CALCULATE(
			    [Total Listing],
			    FILTER(
			        ALL(Listings[city]),
			        [City Rank] <=CurrentRank
			    )
			)
		formatString: 0
		lineageTag: 6c1da584-8c07-4010-8d95-075d0bedfc8c

	measure 'Cumulative %' = ```
			
			 DIVIDE(
			    [Cumulative Listings],
			    CALCULATE([Total Listing],ALL(Listings[city]))
			 )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d1961d32-bcaf-4f14-8b9f-9b88404ab583

	measure 'Avg Price' =
			
			AVERAGE(Listings[price])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e758c09f-77b6-4aaa-af65-516cd65cad56

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Rating' =
			
			AVERAGE(Listings[review_scores_rating])
		formatString: 0.0
		lineageTag: cc349d21-0989-4042-b829-8be99b3202ba

	measure Accuracy =
			
			AVERAGE(Listings[review_scores_accuracy])
		lineageTag: 38fe429d-3377-475f-b38a-d60b43b01946

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Value =
			
			AVERAGE(Listings[review_scores_value])
		lineageTag: e7188559-b79b-448f-930e-c39a1f7e79f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Location =
			
			AVERAGE(Listings[review_scores_location])
		lineageTag: 7637334c-9da2-44b2-bcca-8819dcb7d78e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cleanliness =
			
			AVERAGE(Listings[review_scores_cleanliness])
		lineageTag: 4f3961cd-e605-4451-a1c2-fbe7cc408b08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Communication =
			
			AVERAGE(Listings[review_scores_communication])
		lineageTag: a207f2ad-fd85-408f-b21c-2bb3c05bdd01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

